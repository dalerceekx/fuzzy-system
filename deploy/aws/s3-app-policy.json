{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PrivateBucketHealthAndPrivacy",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketPolicyStatus",
        "s3:GetBucketPublicAccessBlock"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_PRIVATE_BUCKET"
    },
    {
      "Sid": "PrivateFiles",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_PRIVATE_BUCKET/*"
    }
  ]
}
