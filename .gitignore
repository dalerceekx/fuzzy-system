# dotenv environment variable files
.env*
!.env*.example
.deploy/

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Prisma client (generated by `prisma generate`)
apps/backend/src/generated/

# Build caches, uploads, database dumps/backups and private keys must never
# be committed. Migration SQL is source code and stays tracked.
*.tsbuildinfo
uploads/
backups/
*.dump
*.sql
*.sql.gz
*.age
*.gpg
!apps/backend/prisma/migrations/**/*.sql
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*
