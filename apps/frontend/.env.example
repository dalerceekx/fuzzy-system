# Mening Fermam — frontend sozlamalari (Vite).
# Nusxa oling:  cp .env.example .env.development.local
#
# MUHIM: VITE_ bilan boshlanadigan har bir qiymat brauzer bundle'iga kiradi.
# Bu yerga hech qachon backend secret'lari (JWT, DB, S3, SMS kalitlari) yozilmaydi.

# Backend API manzili. Production'da frontend va API bitta domenda bo'lishi
# kerak (masalan nginx: / → SPA, /api/v1 → backend), chunki CSRF cookie
# (__Host-mf_csrf) faqat o'sha host'da o'qiladi. Shunda: VITE_API_BASE_URL=/api/v1
VITE_API_BASE_URL=http://localhost:3001/api/v1

# --- Faqat development (production build'da ishlatilsa build to'xtaydi) ---

# Namuna rejimi: backend o'rniga brauzer ichidagi soxta ma'lumotlar.
# Ekranda doimiy ogohlantirish chiqadi. API xatosida avtomatik yoqilmaydi.
VITE_ENABLE_MOCK=false

# Login sahifasida demo akkaunt tugmalari. Qiymatlar backend seed bilan bir xil
# bo'lishi kerak (apps/backend/.env). Faqat .env.development.local ga yozing.
VITE_SHOW_DEMO_ACCOUNTS=false
VITE_DEMO_SUPER_ADMIN_PHONE=+998900000001
VITE_DEMO_SUPER_ADMIN_PASSWORD=DemoAdmin123!
VITE_DEMO_FARMER_PHONE=+998900000002
VITE_DEMO_FARMER_PASSWORD=DemoFarmer123!
    