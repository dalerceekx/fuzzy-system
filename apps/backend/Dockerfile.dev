# Build context is the monorepo root (the workspace lockfile lives there).
FROM node:26.12.0-alpine3.24

WORKDIR /repo

# Workspace manifests + lockfile; the frontend manifest is needed only so
# `npm ci` accepts the lockfile — frontend dependencies are not installed.
COPY package.json package-lock.json .npmrc ./
COPY apps/backend/package.json apps/backend/
COPY apps/frontend/package.json apps/frontend/
# Prisma schema/config are needed by the backend `postinstall` hook.
COPY apps/backend/prisma.config.ts apps/backend/
COPY apps/backend/prisma apps/backend/prisma
RUN npm ci --workspace apps/backend \
  && cat package.json package-lock.json apps/backend/package.json | sha256sum > node_modules/.deps-hash

COPY apps/backend apps/backend

WORKDIR /repo/apps/backend
RUN npx prisma generate

EXPOSE 3001

CMD ["sh", "./docker/dev-entrypoint.sh"]
