NODE_ENV=development
PORT=3001

# --- Database / cache ---------------------------------------------------------
# Inside the API container `localhost` is the container itself; compose.dev.yaml
# always overrides these with service names. From the host use localhost and
# POSTGRES_PORT, e.g. postgresql://postgres:1234@localhost:5432/meningfermam?schema=public
# Dev credentials (dev only). Production: DATABASE_URL = least-privilege role
# `meningfermam_app`, MIGRATION_DATABASE_URL = schema owner (release step only).
DATABASE_URL=postgresql://postgres:1234@postgres:5432/meningfermam?schema=public
MIGRATION_DATABASE_URL=postgresql://postgres:1234@postgres:5432/meningfermam?schema=public
REDIS_URL=redis://redis:6379

# --- HTTP ---------------------------------------------------------------------
# Express trust proxy: false | 1..3 hops | loopback,uniquelocal,IP/CIDR list.
# Production behind nginx/ALB: TRUST_PROXY=1 (never `true`).
TRUST_PROXY=false
# Exact origins, comma-separated, never `*` (production: https only).
CORS_ORIGINS=http://localhost:5173
# Production default: true (plain-HTTP requests get 403).
HTTPS_REQUIRED=false
HSTS_MAX_AGE_SECONDS=31536000
BODY_LIMIT=100kb
# Swagger UI at /docs; off by default (always off in production unless set).
SWAGGER_ENABLED=true
LOG_LEVEL=info
# Pretty logs are development-only (production refuses LOG_PRETTY=true).
LOG_PRETTY=true
RATE_LIMIT_GLOBAL_PER_MINUTE=300

# --- JWT ------------------------------------------------------------------------
JWT_ISSUER=meningfermam-api
JWT_AUDIENCE=meningfermam-clients
# Separate secrets for access and refresh tokens (>= 32 chars, all different):
#   openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-0123456789abcdef
# Rotation: move the old secret here (comma-separated), remove it once the
# token lifetime has passed. See docs/operations/secrets.md.
JWT_ACCESS_SECRETS_PREVIOUS=
JWT_REFRESH_SECRETS_PREVIOUS=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
MFA_TOKEN_TTL_SECONDS=300

# --- Refresh-token cookie (web) ---------------------------------------------------
# false only for plain-http localhost; production refuses false.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAMESITE=strict

# --- Passwords, OTP, MFA ----------------------------------------------------------
# scrypt N (power of two; production minimum 32768).
PASSWORD_SCRYPT_COST=65536
# HMAC key for OTP digests:  openssl rand -base64 48
OTP_PEPPER=dev-only-otp-pepper-change-me-0123456789abcdef
# Preferred name for new deployments. If both names are set, values must match.
# Leave blank here to keep the existing dev OTP_PEPPER above.
OTP_HMAC_SECRET=
OTP_LENGTH=6
OTP_TTL_SECONDS=300
# Alias of OTP_TTL_SECONDS (both must match when set).
OTP_EXPIRES_IN=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Alias of OTP_RESEND_COOLDOWN_SECONDS (both must match when set).
OTP_RESEND_COOLDOWN=60
OTP_MAX_SENDS=5
# Shared hourly send budget per phone and IP across registration/reset/resend.
OTP_MAX_REQUESTS_PER_HOUR=5
# AES-256-GCM key (exactly 32 bytes, base64):  openssl rand -base64 32
# (this dev value is base64 of the text "dev-only-data-encryption-key-32b")
DATA_ENCRYPTION_KEY=ZGV2LW9ubHktZGF0YS1lbmNyeXB0aW9uLWtleS0zMmI=
DATA_ENCRYPTION_KEYS_PREVIOUS=
MFA_ISSUER="Mening Fermam"

# --- Brute-force protection -------------------------------------------------------
LOGIN_RATE_LIMIT_PER_IP=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
MFA_MAX_ATTEMPTS=5

# --- SMS ------------------------------------------------------------------------
# mock = in-memory inbox (dev/test only; production refuses it).
# GET /api/v1/dev/sms-inbox shows the last messages in development.
SMS_PROVIDER=mock
SMS_ENABLED=true
# true forces the mock provider in dev/test; production refuses it.
SMS_MOCK_MODE=false
# Eskiz setup: docs/operations/eskiz-otp.md. Never put credentials in VITE_*.
# Real sends require SMS_PROVIDER=eskiz and SMS_MOCK_MODE=false.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
# Confirm this sender is approved for YOUR account in the Eskiz panel.
ESKIZ_FROM=4546
# Must match the approved Eskiz template. Keep validity text aligned with TTL.
SMS_OTP_TEMPLATE="RIIZQ: Tasdiqlash kodingiz: {code}. Kod 5 daqiqa amal qiladi. Uni hech kimga bermang."
# For SMS_PROVIDER=http (https only; host must be in SMS_ALLOWED_HOSTS).
SMS_API_URL=
# From the secret manager only; never logged.
SMS_API_KEY=
SMS_SENDER=
SMS_ALLOWED_HOSTS=
# Delivery-report webhook HMAC secret; the webhook is disabled while empty.
#   openssl rand -hex 32
SMS_WEBHOOK_SECRET=
SMS_DAILY_LIMIT_PER_PHONE=10
SMS_DAILY_LIMIT_PER_IP=50
SMS_MAX_SEND_ATTEMPTS=3

# --- File storage -----------------------------------------------------------------
# s3 = private bucket (MinIO in development, S3 in production).
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=meningfermam-private
# Dev MinIO root credentials (dev only). Production: leave empty and use the
# instance/task IAM role.
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=300
# Only for STORAGE_DRIVER=local: absolute path OUTSIDE the project directory,
# e.g. /var/lib/meningfermam/uploads.
UPLOAD_LOCAL_DIR=
UPLOAD_MAX_FILE_BYTES=10485760
UPLOAD_MAX_FILES_PER_USER=500
UPLOAD_USER_QUOTA_BYTES=209715200
UPLOAD_STRIP_METADATA=true

# --- Idempotency ----------------------------------------------------------------
IDEMPOTENCY_TTL_SECONDS=86400

# --- Demo accounts (development/test only) --------------------------------------
# Production refuses DEMO_ACCOUNTS_ENABLED=true and any DEMO_PASSWORD, and the
# demo seed refuses NODE_ENV=production. The seed runs on container start only
# when DEMO_ACCOUNTS_ENABLED=true. There is no default password in code.
DEMO_ACCOUNTS_ENABLED=true
# Password of the staff demo accounts (ADMIN, SUPPORT, VET, second FARMER on
# +998000000001..004); >= 12 chars, letters and digits. Example generator:
#   openssl rand -base64 18
DEMO_PASSWORD=dev-only-Demo-2026
# Main demo logins (dev values chosen by the project owner). The SUPER_ADMIN
# still enrolls TOTP MFA on first login. *_PASSWORD falls back to DEMO_PASSWORD.
DEMO_SUPER_ADMIN_PHONE=+998900000001
DEMO_SUPER_ADMIN_EMAIL=admin@meningfermam.local
DEMO_SUPER_ADMIN_PASSWORD=DemoAdmin123!
DEMO_FARMER_PHONE=+998900000002
DEMO_FARMER_EMAIL=farmer@meningfermam.local
DEMO_FARMER_PASSWORD=DemoFarmer123!

# --- Telemetry (optional; enabled only when both are set) --------------------------
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# --- Host ports for compose.dev.yaml (always bound to 127.0.0.1) -------------------
# Change one only if it is already taken on your machine.
# API_PORT=3001
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
